{
  "expo": {
    "name": "Lookout",
    "slug": "jet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lookout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Lookout saves a photo to your camera roll when you tap Download, and tells that photo's watchers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "jetabs-team",
    "extra": {
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "ab27a2be-784e-4208-ba84-afbbf3b1038a"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ab27a2be-784e-4208-ba84-afbbf3b1038a"
    }
  }
}
